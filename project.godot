; Файл настроек проекта Godot. Обычно его меняют через меню Project > Project Settings.

config_version=5

[application]

config/name="Another World"
config/description="Готический 2D-платформер: девочка-душа ищет своё тело, чтобы ожить."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
SceneLoader="*res://scripts/autoload/scene_loader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://ui/gothic_theme.tres"

